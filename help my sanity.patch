+def is_emoji_character(char: str) -> bool:
+    if not char:
+        return False
+
+    codepoint = ord(char)
+    if codepoint in {0x200D, 0xFE0F}:
+        return True
+
+    return (
+        0x1F300 <= codepoint <= 0x1FAFF
+        or 0x2600 <= codepoint <= 0x27BF
+        or 0x1F1E6 <= codepoint <= 0x1F1FF
+    )
+
